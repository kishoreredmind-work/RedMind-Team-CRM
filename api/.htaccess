# Block access to .env files (Apache 2.4 and 2.2 compatible syntax)
<Files .env>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Forward the Authorization Header to PHP under CGI/FastCGI environments
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    
    # Skip actual files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Route all requests to index.php relatively (compatible with subfolders)
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
